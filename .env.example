# MySQL 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASS=请填写你的MySQL密码
DB_NAME=program1

# 后端服务端口
PORT=3000

# JWT 配置
JWT_SECRET=请替换为一个足够复杂的随机字符串
JWT_EXPIRES_IN=7d

# 智谱 GLM 配置（AI 功能）
# 获取方式：https://open.bigmodel.cn/ 控制台 -> API Keys
GLM_API_KEY=请填写你的智谱APIKey
# 模型名称，免费额度可用 glm-4-flash，更强可换 glm-4-plus / glm-4
GLM_MODEL=glm-4-flash
# 单次请求超时（毫秒），生成题目等长文本建议放宽
GLM_TIMEOUT=60000

# 图片识别（题目图片 OCR 转题库格式）
GLM_VISION_MODEL=glm-4v-flash
GLM_VISION_TIMEOUT=120000
# 开发调试：true 时未配置 GLM_API_KEY 也返回示例识别结果
FORMAT_RECOGNITION_MOCK=false

# DeepSeek 配置（AI 悬浮球错题浓缩）
# 获取方式：https://platform.deepseek.com/ API Keys
DEEPSEEK_API_KEY=your_key_here
# 模型名称，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
